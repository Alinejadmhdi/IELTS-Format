IELTS_PORT=8888
# IELTS_HOST=127.0.0.1

# If Google is blocked, put your local proxy here (bridge reads these):
# HTTPS_PROXY=http://127.0.0.1:2080
# HTTP_PROXY=http://127.0.0.1:2080

# Vision API — Google Gemini is the only tested provider.
# Other OpenAI-compatible endpoints (OpenAI, DashScope/Qwen, custom) can be set
# from the in-app Setup panel but are experimental.
BRIDGE_MODE=http
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=paste-your-gemini-api-key-here
LLM_MODEL=gemini-3.6-flash
# Optional backups. Flash-Lite is multimodal (image+text) and OK for paper→JSON extraction.
# LLM_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite
# Retries follow Google free-tier style limits (RPM spacing + Retry-After / retryDelay).
# VISION_TOTAL_BUDGET_MS=480000
LLM_STATE_DIR=
